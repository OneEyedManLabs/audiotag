<?xml version="1.0" encoding="utf-8"?>
<!--
   AudioTag data extraction rules for Android 12+
   Backup preferences, database, and audio recordings so restores are complete.
   Note: Auto Backup has a 25MB quota; large libraries should use the in-app export feature.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include app preferences/settings -->
        <include domain="sharedpref" path="."/>
        
        <!-- Include database files -->
        <include domain="database" path="."/>
        
        <!-- Include audio recordings referenced by the database -->
        <include domain="file" path="audio_tags"/>
    </cloud-backup>
    
    <!-- Device-to-device transfer: same as cloud backup -->
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <include domain="file" path="audio_tags"/>
    </device-transfer>
</data-extraction-rules>
